# Weight by a transformation of read counts
krona_like_pq(data_fungi_mini, weight_by = log1p, interactive = FALSE)

# Subset of ranks and a custom title
krona_like_pq(
  data_fungi_mini,
  ranks = c("Phylum", "Class", "Order"),
  title = "Fungi — top 3 ranks",
  interactive = FALSE
)
}

\dontrun{
